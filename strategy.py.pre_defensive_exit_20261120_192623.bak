from dataclasses import dataclass
from collections import deque
import time

@dataclass
class BookSignal:
    ratio: float
    spread_bps: float
    mid: float
    bid_value: float
    ask_value: float

def analyse_book(book):
    bids = book.get("bids") or []
    asks = book.get("asks") or []
    if not bids or not asks:
        raise ValueError("Empty order book")
    bid_value = sum(float(p) * float(q) for p, q in bids)
    ask_value = sum(float(p) * float(q) for p, q in asks)
    total = bid_value + ask_value
    if total <= 0:
        raise ValueError("Empty order-book depth")
    best_bid, best_ask = float(bids[0][0]), float(asks[0][0])
    if best_bid <= 0 or best_ask <= best_bid:
        raise ValueError("Invalid/crossed order book")
    mid = (best_bid + best_ask) / 2
    return BookSignal(100 * bid_value / total, 10000 * (best_ask-best_bid)/mid,
                      mid, bid_value, ask_value)

class Confirmation:
    """Require a continuously valid signal; gaps in observations break continuity."""
    def __init__(self, seconds, max_gap_seconds=25):
        if seconds <= 0 or max_gap_seconds <= 0:
            raise ValueError("Confirmation durations must be positive")
        self.seconds = seconds
        self.max_gap_seconds = max_gap_seconds
        self.above_since = {}
        self.last_seen = {}

    def reset(self, symbol):
        self.above_since.pop(symbol, None)
        self.last_seen.pop(symbol, None)

    def reset_all(self):
        self.above_since.clear()
        self.last_seen.clear()

    def reset_unseen(self, active_symbols):
        active = set(active_symbols)
        for symbol in list(self.above_since):
            if symbol not in active:
                self.reset(symbol)

    def update(self, symbol, ratio, threshold, now=None):
        now = time.monotonic() if now is None else now
        if ratio <= threshold:
            self.reset(symbol)
            return False

        previous = self.last_seen.get(symbol)
        if previous is not None and (now <= previous or now - previous > self.max_gap_seconds):
            self.reset(symbol)

        started = self.above_since.setdefault(symbol, now)
        self.last_seen[symbol] = now
        return now - started >= self.seconds

class ExitAnalyser:
    """Select an exit in the +20..+40 net-return band; no fixed tier schedule."""
    def __init__(self):
        self.history = {}

    def evaluate(self, symbol, ratio, mid, net_pct, min_profit=20, max_profit=40):
        hist = self.history.setdefault(symbol, deque(maxlen=12))
        hist.append((time.monotonic(), mid, ratio))
        if net_pct < min_profit:
            return False, "below_minimum_profit"
        prices = [x[1] for x in hist]
        ratios = [x[2] for x in hist]
        momentum = (prices[-1] / prices[0] - 1) * 100 if len(prices) > 1 and prices[0] else 0
        weakening = len(ratios) >= 3 and ratios[-1] < ratios[0] - 3
        # The objective is not to predict a perfect top: sell once profit is in-range
        # and the microstructure says continuation is deteriorating or price stalls.
        if net_pct >= max_profit:
            return True, "upper_profit_limit"
        if weakening and net_pct >= min_profit:
            return True, "buy_pressure_weakening"
        if len(ratios) >= 4 and max(ratios[-4:]) - min(ratios[-4:]) <= 1.0 and net_pct >= min_profit and momentum <= 0.15:
            return True, "momentum_stalling"
        # Exit early inside the band when pressure reverses sharply.
        if len(ratios) >= 2 and ratios[-1] < 50 and net_pct >= min_profit:
            return True, "orderbook_reversal"
        return False, "hold_for_continuation"
