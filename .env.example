# Bitget Classic Spot API credentials. Never commit your real .env file.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Safety defaults: keep PAPER until all checks and paper trading are complete.
TRADING_MODE=paper
LIVE_CONFIRMATION=
LIVE_CONFIRMATION_REQUIRED=I_CONFIRM_SUBACCOUNT_SPOT_LIVE_TRADING
BITGET_ACCOUNT_ROLE=subaccount
BITGET_SUBACCOUNT_ISOLATED=YES

# Strategy
MAX_ALLOCATION_USDT=20
MIN_BUY_RATIO=90
BOOK_LEVELS=15
TOP_SYMBOLS=20
SCAN_INTERVAL_SECONDS=1.0
MAX_BOOK_AGE_MS=3000
MAX_SPREAD_BPS=35
MIN_24H_QUOTE_VOLUME_USDT=100000
MAX_POSITION_AGE_MINUTES=240
EMERGENCY_STOP_NET_PCT=-8
MIN_NET_PROFIT_TO_TAKE=20
MAX_NET_PROFIT_TARGET=40
FEE_RATE_ESTIMATE=0.001
STATE_DB=bot_state.sqlite3
